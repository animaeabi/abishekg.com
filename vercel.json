{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/namma-vedis",
      "destination": "/namma-vedis/index.html"
    }
  ],
  "headers": [
    {
      "source": "/namma-vedis/xr/1.0.0/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/namma-vedis/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), xr-spatial-tracking=(self)"
        }
      ]
    }
  ]
}
