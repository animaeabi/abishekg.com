{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/namma-vedis", "destination": "/namma-vedis/index.html" }
  ],
  "headers": [
    {
      "source": "/namma-vedis/:path*",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)" }
      ]
    }
  ]
}
